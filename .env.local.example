# Development backend target: the Pi's private Netbird address.
# Plain http is correct here — the Netbird (WireGuard) tunnel already encrypts it.
# Find it on the Pi with: netbird status
VITE_DEV_API_TARGET=http://varuna-pi.netbird.cloud:8000
# ...or by IP, if you'd rather not rely on Netbird DNS:
# VITE_DEV_API_TARGET=http://100.92.14.7:8000

# Leave VITE_API_BASE unset. The app then uses same-origin relative paths, which
# the Vite proxy above forwards to the Pi — no CORS, no mixed-content blocking.
# Set it only to make the browser call the Pi directly (needs CORS on FastAPI).

# Performance optimization: Set to 'true' to delay AI model loading
# Models will only load when you navigate to detection screens
# This makes initial page load MUCH faster during development
VITE_LAZY_LOAD_AI=true
