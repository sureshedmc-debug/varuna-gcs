#!/data/data/com.termux/files/usr/bin/bash
# VARUNA: start the phone camera (VARUNA Cam) and the drone telemetry relay together.
# Home-screen shortcut: copy to ~/.shortcuts/VARUNA-Start (see README.md).
#
# VARUNA Cam streams the camera on port 8080 (http://<phone>:8080/video). Opened
# with "background", it starts streaming and steps aside so this window comes back.
# Keep Tailscale connected so the laptop can reach the phone (name it varuna-drone-cam).

if am start -n ai.varuna.cam/.MainActivity --ez background true >/dev/null 2>&1; then
  echo "VARUNA Cam is streaming on port 8080 (stop it from its notification)."
else
  echo "Couldn't open VARUNA Cam. Is it installed? Open it yourself to start the camera."
fi

sleep 3
# vivo goes to the home screen when VARUNA Cam steps aside: bring this window back.
am start -n com.termux/.app.TermuxActivity >/dev/null 2>&1
echo "Starting the relay..."
cd ~ || exit 1
./relay.sh
termux-wake-unlock
echo
read -r -p "Relay stopped (the camera keeps running). Press Enter to close. " _
