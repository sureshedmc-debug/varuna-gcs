[Unit]
Description=VARUNA boat backend (FastAPI + pymavlink)
After=network.target
StartLimitIntervalSec=0

[Service]
User=pi
WorkingDirectory=/home/pi/varuna-boat
ExecStart=/home/pi/varuna-boat/venv/bin/python main.py
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1
# On a Pi Zero the boat must win the single CPU core over background jobs
# (apt timers, man-db, NetBird's housekeeping): a slightly higher priority.
Nice=-5

[Install]
WantedBy=multi-user.target
