<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Same dark base as the app, so there is no white flash on open. -->
    <color name="base">#0E1116</color>

    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/base</item>
        <item name="android:statusBarColor">@color/base</item>
        <item name="android:navigationBarColor">@color/base</item>
        <item name="android:colorAccent">#2DD4BF</item>
    </style>
</resources>
