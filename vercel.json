{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci --no-audit --no-fund",
  "buildCommand": "npm run build && npm run check:clean",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/local/:path*", "destination": "https://varuna-gcs-api.onrender.com/local/:path*" },
    { "source": "/api/:path*", "destination": "https://varuna-gcs-api.onrender.com/api/:path*" },
    { "source": "/video_feed", "destination": "https://varuna-gcs-api.onrender.com/video_feed" },
    { "source": "/stream/:path*", "destination": "https://varuna-gcs-api.onrender.com/stream/:path*" },
    { "source": "/tune/:path*", "destination": "https://varuna-gcs-api.onrender.com/tune/:path*" },
    { "source": "/((?!.*\\.[A-Za-z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
