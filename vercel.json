{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "ELECTRON_SKIP_BINARY_DOWNLOAD=1 npm ci --no-audit --no-fund",
  "buildCommand": "npm run build -- --mode site && npm run check:clean",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/local/:path*", "destination": "https://varuna-gcs-api.onrender.com/local/:path*" },
    { "source": "/site/feedback", "destination": "https://varuna-gcs-api.onrender.com/site/feedback" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/((?!.*\\.[A-Za-z0-9]+$).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/site/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
